              "name": "dohpub",
              "enabled": true,
              "url": "https://doh.pub/dns-query",
              "note": "腾讯 DNSPod DoH（域名形式）——国内最常用的公共 DoH 之一。"
            },
            {
              "name": "safe360",
              "enabled": true,
              "url": "https://doh.360.cn/resolve",
              "note": "360 安全 DNS——国内第三家大厂公共 DoH，独立解析路径。"
            }
          ]
        },
