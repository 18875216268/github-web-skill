    "commands": [
      "git",
      "curl"
    ],
    "note": "拉起 git 与 curl 子进程；均清空代理环境变量后执行。"
  },
  "writes": {
    "user_area": "~/.github-access/（日志 / 缓存 / hosts 备份 / 更新备份；GH_ACCESS_HOME 可覆盖）",
    "system": "仅 hosts 通道，需显式 --yes 且可回滚",
    "package": "运行态零写入；唯一例外 update --apply（显式 --yes：staging 校验→备份→替换→可回滚）"
  }
