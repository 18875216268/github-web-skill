{
  "name": "github-web-skill",
  "author": "木小匣",
  "version": "2.2.0",
  "updated": "2026-09-29",
  "update": {
    "url": "https://github.com/18875216268/github-web-skill",
    "mode": "on-demand（仅显式调用 gh.py update 时检测/下载；本技能从不自检更新）",
    "cli": "gh.py update --check | --apply --yes | --rollback"
  },
  "layers": [
    {
      "id": "main",
      "path": "SKILL.md",
      "role": "主入口（原则 / 通道一览 / 场景路由 / CLI）"
    },
    {
      "id": "routes",
      "path": "routes/",
      "role": "总路由（routes.json 事实源 → ROUTES.md 渲染）"
    },
    {
      "id": "sources",
      "path": "sources/",
      "role": "资源层（hub.py 统一入口 + collect.py 双模式聚合 + speedtest.py 统一测速；sources.json 唯一数据文件，纯外部源每次全新拉取）"
    },
    {
      "id": "channels",
      "path": "channels/",
      "role": "方式目录（一方式一文件夹：实现 + README 内部降级链说明；direct/pin/cdn/mirror/hosts/offline）"
    },
    {
      "id": "scripts",
      "path": "scripts/",
      "role": "CLI 与治理层（gh.py 唯一 CLI + budget/env_guard/report/probe/lines）"
    },
    {
      "id": "update",
      "path": "update/",
      "role": "更新层（仅显式调用：--check 只读检测 / --apply 需 --yes：staging 校验→备份→原地应用→可回滚；本技能从不自检更新）"
    },
    {
      "id": "tests",
      "path": "tests/",
      "role": "单测与真机只读冒烟"
    }
  ],
